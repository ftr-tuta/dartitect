{
  "configVersion": 3,
  "profile": "native_strict",
  "layers": {
    "domain": ["**/domain/**"],
    "application": ["**/application/**"],
    "data": ["**/data/**"],
    "infrastructure": ["**/infrastructure/**"],
    "presentation": ["**/presentation/**"]
  },
  "compositionRoots": ["lib/main.dart", "test/**"],
  "generatedInfrastructure": ["**/infrastructure/**/*.g.dart"],
  "generatedSuffixes": [".g.dart", ".dartitect.g.dart"],
  "suppressions": [],
  "targets": {"platforms": ["android", "ios", "macos", "windows", "linux", "web"]},
  "storageContexts": {
    "local_store": {
      "provider": "custom:canary-store",
      "mode": "durable",
      "scope": "application",
      "factorySource": {
        "source": "lib/composition/canary_factories.dart",
        "declaration": "LocalStoreFactory"
      },
      "targets": ["android", "ios", "macos", "windows", "linux", "web"]
    }
  },
  "transports": {
    "synthetic": {
      "provider": "custom:synthetic",
      "scope": "application",
      "factorySource": {
        "source": "lib/composition/canary_factories.dart",
        "declaration": "SyntheticTransportFactory"
      },
      "targets": ["android", "ios", "macos", "windows", "linux", "web"]
    }
  },
  "contracts": {},
  "observability": {"provider": "none"},
  "scheduler": {"provider": "none"},
  "features": {
    "declarations": {
      "paved_road": {
        "profile": "cache",
        "scope": "application",
        "factorySource": {
          "source": "lib/composition/canary_factories.dart",
          "declaration": "PavedRoadFactory"
        },
        "localAuthority": "custom",
        "storageContext": "local_store",
        "dataset": {
          "dataset": "paved_road",
          "partition": "default_partition",
          "codec": "paved_road_v1",
          "retention": "indefinite",
          "transactionBoundary": "paved_road_transaction"
        },
        "transport": "synthetic",
        "pagination": "cursor",
        "diagnostics": "full",
        "headlessTargets": [],
        "capabilities": [],
        "operations": []
      }
    }
  },
  "extensionSources": []
}
