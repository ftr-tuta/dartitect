{
  "configVersion": 1,
  "profile": "native_strict",
  "layers": {
    "domain": ["**/domain/**"],
    "application": ["**/application/**"],
    "data": ["**/data/**"],
    "infrastructure": ["**/infrastructure/**"],
    "presentation": ["**/presentation/**"]
  },
  "compositionRoots": ["lib/main.dart", "test/**"],
  "generatedInfrastructure": ["**/infrastructure/**/*.g.dart"],
  "generatedSuffixes": [".g.dart", ".dartitect.g.dart"],
  "suppressions": [],
  "features": {
    "declarations": {
      "paved_road": {
        "profile": "offline-full",
        "scope": "application",
        "persistence": {"native": "memory", "web": "memory"},
        "transport": "custom:synthetic",
        "pagination": "cursor",
        "diagnostics": "full",
        "headless": {
          "android": false,
          "ios": false,
          "macos": false,
          "windows": false,
          "linux": false,
          "web": false
        },
        "capabilities": []
      }
    }
  },
  "platforms": ["android", "ios", "macos", "windows", "linux", "web"],
  "scheduler": "none",
  "extensions": {}
}
