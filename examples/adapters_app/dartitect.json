{
  "configVersion": 1,
  "profile": "native_strict",
  "layers": {
    "domain": ["**/domain/**"],
    "application": ["**/application/**"],
    "data": ["**/data/**"],
    "infrastructure": ["**/infrastructure/**"],
    "presentation": [
      "**/presentation/**",
      "**/*_page.dart",
      "**/*_view.dart",
      "**/*_view_model.dart"
    ]
  },
  "compositionRoots": [
    "lib/main.dart",
    "lib/runtime/**",
    "test/**",
    "**/composition/**",
    "**/*_composition_root.dart"
  ],
  "generatedInfrastructure": [
    "**/infrastructure/**/*.g.dart"
  ],
  "suppressions": [],
  "scaffolds": {
    "layout": "feature_first",
    "blueprints": [
      "simple",
      "remote-read",
      "local-first",
      "offline-mutation",
      "sync-dataset"
    ]
  }
}
