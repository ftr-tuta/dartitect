{
  "configVersion": 3,
  "profile": "native_strict",
  "layers": {
    "domain": ["**/domain/**"],
    "application": ["**/application/**"],
    "data": ["**/data/**"],
    "infrastructure": ["**/infrastructure/**"],
    "presentation": [
      "**/presentation/**",
      "**/*_page.dart",
      "**/*_view.dart",
      "**/*_view_model.dart"
    ]
  },
  "compositionRoots": [
    "lib/main.dart",
    "lib/runtime/**",
    "test/**",
    "**/composition/**",
    "**/*_composition_root.dart"
  ],
  "generatedInfrastructure": [
    "**/infrastructure/**/*.g.dart"
  ],
  "generatedSuffixes": [
    ".g.dart",
    ".freezed.dart",
    ".gr.dart",
    ".router.dart",
    ".dartitect.g.dart"
  ],
  "suppressions": [],
  "targets": {"platforms": ["android", "ios", "macos", "windows", "linux", "web"]},
  "storageContexts": {},
  "transports": {},
  "contracts": {},
  "observability": {"provider": "none"},
  "scheduler": {"provider": "none"},
  "features": {"declarations": {}},
  "extensionSources": []
}
