{
  "configVersion": 1,
  "profile": "native_strict",
  "layers": {
    "domain": ["**/domain/**"],
    "application": ["**/application/**"],
    "data": ["**/data/**"],
    "infrastructure": ["**/infrastructure/**"],
    "presentation": [
      "**/presentation/**",
      "**/*_page.dart",
      "**/*_view.dart",
      "**/*_view_model.dart"
    ]
  },
  "compositionRoots": [
    "lib/main.dart",
    "lib/app/**",
    "test/**",
    "**/composition/**",
    "**/*_composition_root.dart"
  ],
  "generatedInfrastructure": [
    "**/infrastructure/**/*.g.dart",
    "lib/objectbox.g.dart"
  ],
  "generatedSuffixes": [
    ".g.dart",
    ".freezed.dart",
    ".gr.dart",
    ".router.dart",
    ".dartitect.g.dart"
  ],
  "suppressions": [],
  "features": {"declarations": {}},
  "platforms": ["android", "ios", "macos", "windows", "linux", "web"],
  "scheduler": "none",
  "extensions": {}
}
