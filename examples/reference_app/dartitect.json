{
  "configVersion": 3,
  "profile": "native_strict",
  "layers": {
    "domain": ["**/domain/**"],
    "application": ["**/application/**"],
    "data": ["**/data/**"],
    "infrastructure": ["**/infrastructure/**"],
    "presentation": [
      "**/presentation/**",
      "lib/src/dev/**",
      "**/lib/src/dev/**",
      "**/*_page.dart",
      "**/*_view.dart",
      "**/*_view_model.dart"
    ]
  },
  "compositionRoots": [
    "lib/main.dart",
    "lib/app/**",
    "test/**",
    "integration_test/**",
    "**/composition/**",
    "**/*_composition_root.dart"
  ],
  "generatedInfrastructure": [
    "**/infrastructure/**/*.g.dart",
    "lib/objectbox.g.dart"
  ],
  "generatedSuffixes": [
    ".g.dart",
    ".freezed.dart",
    ".gr.dart",
    ".router.dart",
    ".dartitect.g.dart"
  ],
  "suppressions": [],
  "targets": {"platforms": ["android", "ios", "macos", "windows", "linux", "web"]},
  "storageContexts": {
    "reference_runtime": {
      "provider": "custom:reference-runtime",
      "mode": "durable",
      "scope": "application",
      "factorySource": {
        "source": "lib/composition/reference_factories.dart",
        "declaration": "ReferenceRuntimeFactory"
      },
      "targets": ["android", "ios", "macos", "windows", "linux", "web"]
    }
  },
  "transports": {
    "reference_transport": {
      "provider": "custom:reference-transport",
      "scope": "application",
      "factorySource": {
        "source": "lib/composition/reference_factories.dart",
        "declaration": "ReferenceTransportFactory"
      },
      "targets": ["android", "ios", "macos", "windows", "linux", "web"]
    }
  },
  "contracts": {},
  "observability": {"provider": "none"},
  "scheduler": {"provider": "none"},
  "features": {
    "declarations": {
      "tasks": {
        "profile": "cache",
        "scope": "application",
        "factorySource": {
          "source": "lib/features/tasks/composition/tasks_factory.dart",
          "declaration": "TasksFactory"
        },
        "localAuthority": "custom",
        "storageContext": "reference_runtime",
        "transport": "reference_transport",
        "dataset": {
          "dataset": "tasks",
          "partition": "reference",
          "codec": "tasks_v1",
          "retention": "indefinite",
          "transactionBoundary": "reference_tasks"
        },
        "pagination": "cursor",
        "diagnostics": "full",
        "headlessTargets": [],
        "capabilities": [],
        "operations": []
      }
    }
  },
  "extensionSources": []
}
