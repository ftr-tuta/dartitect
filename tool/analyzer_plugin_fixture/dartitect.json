{
  "configVersion": 3,
  "profile": "native_strict",
  "layers": {
    "presentation": [
      "**/presentation/**",
      "lib/src/dev/**",
      "**/lib/src/dev/**"
    ],
    "application": ["**/application/**"],
    "domain": ["**/domain/**"],
    "data": ["**/data/**"],
    "infrastructure": ["**/infrastructure/**"]
  },
  "compositionRoots": ["lib/main.dart", "**/composition/**"],
  "generatedInfrastructure": ["**/infrastructure/**/*.g.dart"],
  "generatedSuffixes": [
    ".g.dart",
    ".freezed.dart",
    ".gr.dart",
    ".router.dart",
    ".dartitect.g.dart"
  ],
  "suppressions": [],
  "targets": {"platforms": ["android", "ios", "macos", "windows", "linux", "web"]},
  "storageContexts": {},
  "transports": {},
  "contracts": {},
  "observability": {"provider": "none"},
  "scheduler": {"provider": "none"},
  "features": {"declarations": {}},
  "extensionSources": []
}
