{
  "schemaVersion": 1,
  "cohortVersion": "1.0.0-rc.8",
  "artifactSource": "git-archive-exact-head",
  "digestAlgorithm": "sha256",
  "installation": {
    "source": "ephemeral-hosted-repository",
    "isolatedConsumerDirectories": true,
    "sharedCacheRequiresDigestProof": true,
    "monorepoPathResolution": false,
    "dependencyOverrides": false
  },
  "gitInstallation": {
    "repository": "https://github.com/ftr-tuta/dartitect.git",
    "ref": "v1.0.0-rc.8",
    "annotatedTagRequired": true,
    "dependencyOverrides": true,
    "transitiveClosureRequired": true,
    "localPathResolution": false,
    "hostedDartitectResolution": false
  },
  "canaries": [
    {
      "id": "modeling",
      "source": "examples/model_generator_fixture",
      "pubspec": "tool/canaries/modeling/pubspec.yaml",
      "requiredPackages": [
        "dartitect",
        "dartitect_cli",
        "dartitect_modeling",
        "dartitect_modeling_analyzer"
      ],
      "forbiddenPackages": [
        "dartitect_drift",
        "dartitect_flutter",
        "dartitect_objectbox"
      ],
      "commands": [
        "flutter pub get",
        "dart run dartitect_cli:dartitect model sync --apply",
        "dart run dartitect_cli:dartitect model check",
        "dart run dartitect_cli:dartitect verify --json",
        "dart analyze",
        "dart test",
        "dart test --platform chrome"
      ],
      "coverage": [
        "pure_dart_modeling",
        "json",
        "projection",
        "mapper",
        "chrome",
        "clean_clone"
