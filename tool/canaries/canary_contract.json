{
  "schemaVersion": 1,
  "cohortVersion": "1.0.0-rc.3",
  "artifactSource": "git-archive-exact-head",
  "digestAlgorithm": "sha256",
  "installation": {
    "source": "ephemeral-hosted-repository",
    "isolatedConsumerDirectories": true,
    "sharedCacheRequiresDigestProof": true,
    "monorepoPathResolution": false,
    "dependencyOverrides": false
  },
  "gitInstallation": {
    "repository": "https://github.com/ftr-tuta/dartitect.git",
    "ref": "v1.0.0-rc.3",
    "annotatedTagRequired": true,
    "dependencyOverrides": true,
    "transitiveClosureRequired": true,
    "localPathResolution": false,
    "hostedDartitectResolution": false
  },
  "canaries": [
    {
      "id": "minimal",
      "source": "tool/canaries/minimal",
      "pubspec": "tool/canaries/minimal/pubspec.yaml",
      "requiredPackages": [
        "dartitect",
        "dartitect_cli",
        "dartitect_flutter"
      ],
      "forbiddenPackages": [
        "dartitect_geometry",
        "dartitect_lints",
        "dartitect_locale_br",
        "dartitect_mcp",
        "dartitect_media",
        "dartitect_objectbox",
        "dartitect_privacy",
        "dartitect_sentry"
      ],
      "commands": [
        "flutter pub get",
        "dart run dartitect_cli:dartitect model sync --apply",
        "dart run dartitect_cli:dartitect model check",
        "flutter analyze",
        "flutter test"
      ],
      "coverage": [
        "flutter_simple",
        "noncooperative_cancellation",
        "large_assets",
        "multipackage_workspace",
        "consumer_owned_codegen"
      ],
      "residualResourceCensus": 0
    },
    {
      "id": "offline_first",
      "source": "examples/reference_app",
      "pubspec": "tool/canaries/offline_first/pubspec.yaml",
      "requiredPackages": [
        "dartitect",
        "dartitect_dio",
        "dartitect_flutter",
        "dartitect_isolates",
        "dartitect_objectbox",
        "dartitect_observability",
        "dartitect_sync"
      ],
      "forbiddenPackages": [],
      "commands": [
        "flutter pub get",
        "flutter analyze",
        "flutter test test/offline_first_session_test.dart test/widget_test.dart",
        "DARTITECT_NATIVE_OBJECTBOX=1 flutter test test/native_objectbox_workload_test.dart",
        "flutter build host-desktop"
      ],
      "coverage": [
        "objectbox_local_first",
        "outbox_sync",
        "desktop",
        "session_replacement"
      ],
      "residualResourceCensus": 0
    },
    {
      "id": "native_capabilities",
      "source": "tool/canaries/native_capabilities",
      "pubspec": "tool/canaries/native_capabilities/pubspec.yaml",
      "requiredPackages": [
        "dartitect",
        "dartitect_geometry",
        "dartitect_locale_br",
        "dartitect_media",
        "dartitect_privacy"
      ],
      "forbiddenPackages": [
        "dartitect_objectbox",
        "dartitect_sentry"
      ],
      "commands": [
        "flutter pub get",
        "flutter analyze",
        "flutter test"
      ],
      "coverage": ["native_capabilities"],
      "residualResourceCensus": 0
    }
  ],
  "deferredToV1S13": [
    "hosted Android 14/API 34 emulator execution in GitHub Actions",
    "Android API 24 build compatibility without an emulator",
    "iOS deployment-floor builds and current hosted simulator execution",
    "current-run lifecycle, callback, cleanup, and source-tree manifests"
  ]
}
