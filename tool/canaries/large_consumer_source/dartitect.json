{
  "configVersion": 3,
  "profile": "native_strict",
  "layers": {
    "domain": [
      "**/domain/**"
    ],
    "application": [
      "**/application/**"
    ],
    "data": [
      "**/data/**"
    ],
    "infrastructure": [
      "**/infrastructure/**"
    ],
    "presentation": [
      "**/presentation/**"
    ]
  },
  "compositionRoots": [
    "lib/main.dart",
    "test/**",
    "**/composition/**"
  ],
  "generatedInfrastructure": [
    "**/infrastructure/**/*.g.dart"
  ],
  "generatedSuffixes": [
    ".g.dart",
    ".dartitect.g.dart"
  ],
  "suppressions": [],
  "targets": {
    "platforms": [
      "linux",
      "web"
    ]
  },
  "storageContexts": {
    "app_storage": {
      "provider": "drift",
      "mode": "durable",
      "scope": "application",
      "factorySource": {
        "source": "lib/large_factories.dart",
        "declaration": "AppStorageFactory"
      },
      "targets": [
        "linux",
        "web"
      ]
    },
    "session_storage": {
      "provider": "drift",
      "mode": "durable",
      "scope": "session",
      "factorySource": {
        "source": "lib/large_factories.dart",
        "declaration": "SessionStorageFactory"
      },
      "targets": [
        "linux",
        "web"
      ]
    }
  },
  "transports": {
    "app_api": {
      "provider": "dio",
      "scope": "application",
      "factorySource": {
        "source": "lib/large_factories.dart",
        "declaration": "AppTransportFactory"
      },
      "targets": [
        "linux",
        "web"
      ]
    },
    "session_api": {
      "provider": "dio",
      "scope": "session",
      "factorySource": {
        "source": "lib/large_factories.dart",
        "declaration": "SessionTransportFactory"
      },
      "targets": [
        "linux",
        "web"
      ]
    }
  },
  "session": {
    "factorySource": {
      "source": "lib/large_factories.dart",
      "declaration": "LargeSessionFactory"
    }
  },
  "contracts": {
    "app_api": {
      "spec": "contracts/app_api.json",
      "output": "lib/contracts/app_api.contracts.dartitect.g.dart",
      "transport": "app_api"
    }
  },
  "observability": {
    "provider": "developer"
  },
  "scheduler": {
    "provider": "workmanager",
    "targets": [
      "linux",
      "web"
    ]
  },
