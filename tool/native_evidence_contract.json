{
  "schemaVersion": 3,
  "manifestSchemaVersion": 3,
  "goal": "V1S-13",
  "authority": "github-actions-current-run",
  "harness": "tool/canaries/native_capabilities",
  "android": {
    "floorApi": 24,
    "emulatorApi": 34,
    "systemImage": "system-images;android-34;google_apis;x86_64",
    "avdName": "dartitect-api-34",
    "applicationId": "dev.dartitect.dartitect_native_capabilities_harness",
    "manifest": "packages/dartitect_media/android/src/main/AndroidManifest.xml",
    "plugin": "packages/dartitect_media/android/src/main/java/dev/dartitect/media/DartitectMediaPlugin.java",
    "requiredSourceMarkers": [
      "android:maxSdkVersion=\"28\"",
      "Build.VERSION_CODES.Q",
      "legacy_write_requested",
      "removeRequestPermissionsResultListener",
      "mainHandler.post",
      "MediaStore.Images.Media.IS_PENDING",
      "getContentResolver().delete(inserted"
    ]
  },
  "ios": {
    "mediaFloor": "14.0",
    "privacyFloor": "12.0",
    "mediaPodspec": "packages/dartitect_media/ios/dartitect_media.podspec",
    "privacyPodspec": "packages/dartitect_privacy/ios/dartitect_privacy.podspec",
    "mediaPlugin": "packages/dartitect_media/ios/Classes/DartitectMediaPlugin.swift",
    "privacyPlugin": "packages/dartitect_privacy/ios/Classes/DartitectPrivacyPlugin.swift",
    "requiredSourceMarkers": [
      "PHAccessLevel = .readWrite",
      "case .limited",
      "performChanges",
      "DispatchQueue.main.async",
      "ATTrackingManager.requestTrackingAuthorization"
    ]
  },
  "requiredCells": [
    {
      "id": "android-media-floor-build",
      "platform": "android",
      "capabilities": ["media"],
      "evidenceKind": "build",
      "floor": true,
      "requiredVersionKeys": ["os", "flutter", "dart", "androidSdk", "java"],
      "requiredScenarios": [
        "min-sdk-24",
        "manifest-contract",
        "android-lint",
        "debug-apk-build",
        "tree-clean"
      ]
    },
    {
      "id": "android-media-current-emulator",
      "platform": "android",
      "capabilities": ["media", "privacy"],
      "evidenceKind": "emulator",
      "floor": false,
      "requiredVersionKeys": ["os", "flutter", "dart", "androidSdk", "adb"],
      "requiredScenarios": [
        "github-hosted-runner",
        "clean-avd",
        "boot-complete",
        "api-34",
        "status-without-legacy-permission",
        "privacy-not-supported",
        "save-with-album",
        "source-preserved",
        "missing-file",
        "invalid-file",
        "main-thread-callback",
        "liveness-after-failure",
        "rotation-restored",
        "background-foreground",
        "owned-state-cleanup",
        "media-cleanup",
        "application-data-clean",
        "emulator-shutdown",
        "tree-clean"
      ]
    },
    {
      "id": "ios-media-floor-build",
      "platform": "ios",
      "capabilities": ["media"],
      "evidenceKind": "build",
      "floor": true,
      "requiredVersionKeys": ["os", "flutter", "dart", "xcode", "iosSdk"],
      "requiredScenarios": [
        "deployment-target-ios-14",
        "media-plugin-compile",
        "simulator-link",
        "tree-clean"
      ]
    },
    {
      "id": "ios-privacy-floor-build",
      "platform": "ios",
      "capabilities": ["privacy"],
      "evidenceKind": "build",
      "floor": true,
      "requiredVersionKeys": ["os", "flutter", "dart", "xcode", "iosSdk"],
      "requiredScenarios": [
        "deployment-target-ios-12",
        "privacy-plugin-compile",
        "simulator-link",
        "tree-clean"
      ]
    },
    {
      "id": "ios-current-simulator",
      "platform": "ios",
      "capabilities": ["media", "privacy"],
      "evidenceKind": "simulator",
      "floor": false,
      "requiredVersionKeys": [
        "os",
        "flutter",
        "dart",
        "xcode",
        "iosSdk",
        "photosPermissionTool"
      ],
      "requiredScenarios": [
        "dynamic-installed-simulator-selection",
        "photos-status-request-real-channel",
        "att-real-channel",
        "deterministic-native-status-contracts",
        "save-with-album",
        "source-preserved",
        "missing-file",
        "invalid-file",
        "main-thread-callback",
        "background-foreground",
        "simulator-cleanup",
        "tree-clean"
      ]
    }
  ],
  "manifestDirectory": "build/native-evidence",
  "manifestDigest": "sha256",
  "trackedTreeMustRemainClean": true,
  "hostedRunnersOnly": true,
  "allowedEvidenceKinds": ["build", "emulator", "simulator"]
}
