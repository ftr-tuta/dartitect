{
  "schemaVersion": 1,
  "authority": "github-actions",
  "workflow": "CI",
  "workflowPath": ".github/workflows/ci.yaml",
  "events": ["pull_request", "merge_group", "push-main"],
  "requiredCheck": "CI / Required",
  "releaseBranch": "refs/heads/main",
  "formalEvent": "push",
  "artifact": {
    "name": "actions-readiness-v1",
    "manifest": "actions-readiness-v1.json",
    "retentionDays": 90
  },
  "requiredJobs": [
    "linux",
    "windows",
    "macos",
    "android-emulator",
    "drift-web",
    "clean-clone",
    "git-consumption",
    "osv"
  ],
  "nativeCells": [
    "android-media-floor-build",
    "android-media-current-emulator",
    "ios-media-floor-build",
    "ios-privacy-floor-build",
    "ios-current-simulator"
  ],
  "repositoryArtifacts": [
    "docs/release/sbom.spdx.json",
    "docs/release/dependency-licenses.json",
    "tool/api_surface.snapshot.json",
    "tool/actions_readiness_policy.json",
    "tool/distribution_policy.json",
    "tool/package_release_contract.json",
    "tool/stable_candidate_contract.json",
    "tool/dependency_snippets.dart",
    "tool/build_release_assets.dart",
    "tool/github_ruleset_policy.json",
    "tool/github_release_ruleset_policy.json",
    "tool/ui_quality_contract.json"
  ],
  "release": {
    "workflowPath": ".github/workflows/release.yaml",
    "manualOnly": true,
    "requiredInputs": ["source_sha", "ci_run_id"]
  },
  "localValidationCanDeclareReadiness": false,
  "hostedRunnersOnly": true
}
